<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_rounded"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="32dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊"
                android:textSize="48sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Info"
                android:textColor="#C7D2FE"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_margin="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Details"
                android:textColor="#1E1B4B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💊 "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvMedForm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Form: N/A"
                    android:textColor="#4B5563"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚖️ "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvMedStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Strength: N/A"
                    android:textColor="#4B5563"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Active Ingredient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔬 "
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvMedIngredient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Ingredient: N/A"
                    android:textColor="#4B5563"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E7FF"
                android:layout_marginBottom="16dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Description"
                android:textColor="#8B5CF6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvMedDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnGoToMedicines"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GO TO MY MEDICINES"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnScanAgain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SCAN AGAIN"
            android:textColor="#6366F1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_primary"
            android:stateListAnimator="@null"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>