<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_white"
                android:src="@drawable/ic_back"
                android:tint="#6366F1"
                android:contentDescription="Back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interaction Result"
                android:textColor="#1E1B4B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Risk icon big -->
        <LinearLayout
            android:id="@+id/layoutRiskIcon"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvRiskEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="56sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvRiskLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium Risk"
                android:textColor="#C2410C"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRiskSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drug Interaction Detected"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Medicines involved -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicines Involved"
                    android:textColor="#1E1B4B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView android:id="@+id/tvMed1"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_med_chip_blue"
                        android:text="Medicine 1"
                        android:textColor="#3730A3"
                        android:textSize="13sp" android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp" />

                    <TextView
                        android:layout_width="32dp" android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp" />

                    <TextView android:id="@+id/tvMed2"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_med_chip_purple"
                        android:text="Medicine 2"
                        android:textColor="#5B21B6"
                        android:textSize="13sp" android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Description -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚕️ Medical Information"
                    android:textColor="#1E1B4B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Interaction description will appear here..."
                    android:textColor="#4B5563"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action buttons -->
        <!-- Shown for Low/Medium: Add anyway -->
        <Button
            android:id="@+id/btnAddAnyway"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ADD ANYWAY (I UNDERSTAND)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_warn"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Always shown: Cancel -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="GO BACK"
            android:textColor="#6366F1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline_primary"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>